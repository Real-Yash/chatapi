DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatapi
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ChatAPI
UPLOAD_DIR=./uploads
EMBED_DIMS=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=8
