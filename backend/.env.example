VECTOR_WEIGHT=0.7

# Crawler
SCRAPE_MAX_PAGES=25
SCRAPE_MAX_CANDIDATES=300
SCRAPE_CONCURRENCY=6
SCRAPE_DELAY_MS=350
SCRAPE_TIMEOUT=15
SCRAPE_LLM_RANK=1
SCRAPE_RANK_MODEL=google/gemma-4-31b-it:free
SCRAPE_MIN_TEXT_CHARS=200
SCRAPE_MIN_PAGE_CHARS=40
SCRAPE_JS_RENDER=1
